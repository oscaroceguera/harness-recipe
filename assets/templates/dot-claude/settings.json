{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash({{pm}} run *)",
      "Bash({{pm}} test*)",
      "Bash({{pmx}} vitest*)",
      "Bash({{pmx}} playwright*)",
      "Bash({{pmx}} eslint*)",
      "Bash({{pmx}} prettier*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)"
    ],
    "ask": ["Bash(git push*)", "Bash({{pm}} add*)", "Bash({{pm}} remove*)"],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(cat .env*)",
      "Read(./dist/**)"
    ]
  }
}
